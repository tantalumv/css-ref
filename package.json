{
  "name": "css-ref",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:js:bun": "bun build src/main.ts --outfile=dist/bundle.js --target=browser --watch --sourcemap=external",
    "dev:js:node": "esbuild src/main.ts --bundle --outfile=dist/bundle.js --target=es2020 --watch --sourcemap=external --format=esm",
    "dev:css": "esbuild src/styles/index.css --bundle --outfile=dist/bundle.css --watch --sourcemap",
    "dev:bun": "concurrently \"npm:dev:js:bun\" \"npm:dev:css\"",
    "dev:node": "concurrently \"npm:dev:js:node\" \"npm:dev:css\"",
    "dev": "npm run dev:bun",
    "build:bun": "node scripts/build.js",
    "build:node": "node scripts/build.js",
    "build": "node scripts/build.js",
    "build:all": "node scripts/build.js",
    "build:only": "node scripts/build.js",
    "serve:bun": "node scripts/build.js && npx serve . -p 2005",
    "serve:node": "node scripts/build.js && npx serve . -p 2005",
    "serve": "node scripts/build.js && npx serve . -p 2005",
    "serve:dev": "npm run build:only && bun scripts/serve.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bunx playwright test",
    "test:e2e:ui": "bunx playwright test --ui",
    "test:e2e:node": "npx playwright test",
    "lint": "oxlint src/",
    "lint:fix": "oxlint src/ --fix",
    "lint:datastar": "oxlint --config .oxlintrc.json '**/*.html' src/",
    "lint:datastar:fix": "oxlint --config .oxlintrc.json '**/*.html' src/ --fix",
    "manifest:generate:bun": "bun scripts/generate-manifest.ts --check",
    "manifest:generate:node": "node scripts/generate-manifest.ts --check",
    "manifest:generate": "npm run manifest:generate:bun",
    "manifest:check:bun": "bun scripts/generate-manifest.ts --check",
    "manifest:check:node": "node scripts/generate-manifest.ts --check",
    "manifest:check": "npm run manifest:check:bun",
    "typecheck": "oxlint src/ --type-aware --config .oxlintrc.typecheck.json && tsc --noEmit",
    "analyze:bun": "bun build src/main.ts --outfile=dist/bundle.js --metafile=dist/meta.json && echo 'Bundle analysis metafile generated at dist/meta.json'",
    "analyze:node": "esbuild src/main.ts --bundle --outfile=dist/bundle.js --metafile=dist/meta.json --format=esm && echo 'Bundle analysis metafile generated at dist/meta.json'",
    "analyze": "npm run analyze:bun",
    "validate:demos:bun": "bun run scripts/validate-demos.ts",
    "validate:demos:node": "node scripts/validate-demos.ts",
    "validate:demos": "npm run validate:demos:bun"
  },
  "dependencies": {
    "fuzzysort": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "concurrently": "^10.0.3",
    "esbuild": "^0.27.3",
    "happy-dom": "^20.8.3",
    "oxlint": "^1.51.0",
    "serve": "^14.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
